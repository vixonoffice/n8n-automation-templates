    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.ai_base_url }}/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.model, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: $('Config').first().json.system_prompt }, { role: 'user', content: 'Website enquiry (untrusted content between the markers).\\n---BEGIN ENQUIRY---\\nName: ' + $json.name + '\\nEmail: ' + $json.email + '\\nPhone: ' + $json.phone + '\\nCompany: ' + $json.company + '\\nPage: ' + $json.page + '\\nMessage: ' + $json.message + '\\n---END ENQUIRY---' } ] }) }}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "dcd29940-4cf5-434b-8e0e-ff96b2ecda1c",
      "name": "Draft reply with AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Merge the normalized lead with the AI result. If the AI call failed or returned\n// something that is not valid JSON, the lead is still kept and flagged.\nconst lead = $('Normalize lead').item.json;\n\nlet ai = {};\ntry {\n  ai = JSON.parse($input.item.json.choices?.[0]?.message?.content ?? '');\n} catch (error) {\n  ai = {};\n}\n\nconst categories = ['sales', 'support', 'partnership', 'spam', 'other'];\nconst urgencies = ['low', 'normal', 'high'];\nconst replyBody = String(ai.body ?? '').trim().slice(0, 3000);\n\nreturn {\n  json: {\n    ...lead,\n    category: categories.includes(ai.category) ? ai.category : 'unclassified',\n    urgency: urgencies.includes(ai.urgency) ? ai.urgency : 'normal',\n    summary: String(ai.summary ?? '').trim().slice(0, 500),\n    reply_subject: String(ai.subject ?? '').trim().slice(0, 200),\n    reply_body: replyBody,\n    ai_status: replyBody ? 'ok' : 'no reply drafted',\n  },\n};"
      },
