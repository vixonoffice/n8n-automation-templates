    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.ai_base_url }}/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.model, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: $('Config').first().json.system_prompt }, { role: 'user', content: 'Lead (untrusted content between the markers).\\n---BEGIN LEAD---\\nName: ' + $json.name + '\\nEmail: ' + $json.email + '\\nPhone: ' + $json.phone + '\\nCompany: ' + $json.company + '\\nJob title: ' + $json.job_title + '\\nCountry: ' + $json.country + '\\nStated budget: ' + $json.budget + '\\nSource: ' + $json.source + '\\nMessage: ' + $json.message + '\\n---END LEAD---' } ] }) }}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "760918d3-bae6-49ff-bae8-38a58af4f802",
      "name": "Score lead with AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turn the AI answer into a safe, typed result. The tier is derived from the score\n// with the thresholds from the Config node, so the routing never depends on free text.\nconst lead = $('Normalize lead').item.json;\nconst cfg = $('Config').first().json;\n\nlet ai = {};\ntry {\n  ai = JSON.parse($input.item.json.choices?.[0]?.message?.content ?? '');\n} catch (error) {\n  ai = {};\n}\n\nconst rawScore = Number(ai.score);\nconst failed = !Number.isFinite(rawScore);\nconst score = failed ? 0 : Math.max(0, Math.min(100, Math.round(rawScore)));\n\nconst hotAt = Number(cfg.hot_threshold) || 70;\nconst warmAt = Number(cfg.warm_threshold) || 40;\n\n// If scoring failed, send the lead to the middle tier so a human looks at it.\nlet tier = 'cold';\nif (failed) tier = 'warm';\nelse if (score >= hotAt) tier = 'hot';\nelse if (score >= warmAt) tier = 'warm';\n\nconst oneOf = (value, allowed, fallback) => (allowed.includes(value) ? value : fallback);\nconst list = (value) => (Array.isArray(value) ? value.map((x) => String(x)).join(' | ') : '');\n\nreturn {\n  json: {\n    ...lead,\n    score,\n    tier,\n    intent: oneOf(ai.intent, ['low', 'medium', 'high'], 'unknown'),\n    budget_signal: oneOf(ai.budget_signal, ['none', 'unclear', 'low', 'medium', 'high'], 'unknown'),\n    summary: failed ? 'AI scoring failed, review this lead manually.' : String(ai.summary ?? '').slice(0, 500),\n    reasons: list(ai.reasons).slice(0, 600),\n    red_flags: list(ai.red_flags).slice(0, 600),\n    next_action: String(ai.next_action ?? '').slice(0, 300),\n    scoring_status: failed ? 'failed' : 'ok',\n  },\n};"
      },
